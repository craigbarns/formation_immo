# Copier vers .env.local et remplir.

# Mot de passe unique d’accès à la formation (changez-le en production).
LMS_PASSWORD=votre-mot-de-passe-securise

# Secret de chiffrement du cookie de session — minimum 32 caractères.
# Générer : openssl rand -base64 32
SESSION_SECRET=remplacez-par-au-moins-trente-deux-caracteres-aleatoires

# --- D-ID (optionnel, tests / intégration vidéo) — NE PAS COMMITER ---
# DID_API_USER=identifiant_exact_fourni_par_D-ID
# DID_API_SECRET=secret_fourni_par_D-ID

# --- LiveAvatar (HeyGen) — embed interactif — clé sur https://app.liveavatar.com/developers
# LIVEAVATAR_API_KEY=
# LIVEAVATAR_AVATAR_ID=   # optionnel (sandbox = avatar Wayne imposé par l’API si non défini)
# Contexte « Formation Loi ALUR » : node scripts/liveavatar-create-alur-context.mjs puis coller l’id ici
# LIVEAVATAR_ALUR_CONTEXT_ID=
# Contextes HeyGen par leçon (JSON) — surcharge le contexte ALUR pour moduleSlug/leçon :
# LIVEAVATAR_LESSON_CONTEXTS={"juridique/loi-alur":"<uuid>","financement/rentabilite":"<uuid>"}
# Voix qui ne répond pas en sandbox : essayez LIVEAVATAR_EMBED_SANDBOX=false (consomme des crédits)
# LIVEAVATAR_EMBED_SANDBOX=true
# Langue STT (ex. fr, en, multi) — si vide, sandbox utilise multi, prod utilise fr
# LIVEAVATAR_DEFAULT_LANGUAGE=

# --- ElevenLabs (TTS / voix avatar) — https://elevenlabs.io — ne pas commiter la clé
# ELEVENLABS_API_KEY=
# Liste des voix + scores FR : npm run elevenlabs:voices
# Échantillons MP3 (top 8) : npm run elevenlabs:samples

# --- Mistral Voxtral (TTS) — narration MP3 — https://docs.mistral.ai/capabilities/audio/text_to_speech
# MISTRAL_API_KEY=
# Voix par défaut : `src/data/formateur-voices.json` (un preset par formateur).
# Optionnel — forcer une voix pour un module (UUID Mistral) :
# MISTRAL_VOICE_ID_JURIDIQUE=
# MISTRAL_VOICE_ID_TRANSACTION=
# MISTRAL_VOICE_ID_FINANCEMENT=
# MISTRAL_VOICE_ID_MARKETING=
# MISTRAL_VOICE_ID_TERRAIN=
# Fallback global si tout est vide :
# MISTRAL_VOICE_ID=
# MISTRAL_VOICE_ID_MALE=
# MISTRAL_VOICE_ID_FEMALE=

# --- Fal.ai (images / vidéos) — https://fal.ai/dashboard — NE PAS COMMITER la clé
# FAL_KEY=
