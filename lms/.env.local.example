# Copier vers .env.local et remplir.

# URL publique de l'app. En local : http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mot de passe unique d’accès à la formation (changez-le en production).
LMS_PASSWORD=votre-mot-de-passe-securise

# Secret de chiffrement du cookie de session — minimum 32 caractères.
# Générer : openssl rand -base64 32
SESSION_SECRET=remplacez-par-au-moins-trente-deux-caracteres-aleatoires

# --- D-ID (vidéos avatar — API) — NE PAS COMMITER ---
# Studio : https://studio.d-id.com/ — clés API (Basic Auth) :
# DID_API_USER=identifiant_fourni_par_D-ID
# DID_API_SECRET=secret_fourni_par_D-ID
# Scripts : lms/scripts/did-test.mjs, did-generate-lesson-01.mjs (voir README)


# --- Mistral Voxtral (TTS) — narration MP3 — https://docs.mistral.ai/capabilities/audio/text_to_speech
# MISTRAL_API_KEY=
# Voix par défaut : `src/data/formateur-voices.json` (un preset par formateur).
# Optionnel — forcer une voix pour un module (UUID Mistral) :
# MISTRAL_VOICE_ID_JURIDIQUE=
# MISTRAL_VOICE_ID_TRANSACTION=
# MISTRAL_VOICE_ID_FINANCEMENT=
# MISTRAL_VOICE_ID_MARKETING=
# MISTRAL_VOICE_ID_TERRAIN=
# Fallback global si tout est vide :
# MISTRAL_VOICE_ID=
# MISTRAL_VOICE_ID_MALE=
# MISTRAL_VOICE_ID_FEMALE=

# --- Fal.ai (images / vidéos) — https://fal.ai/dashboard — NE PAS COMMITER la clé
# FAL_KEY=
