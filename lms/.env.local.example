# Copier vers .env.local et remplir.

# ── App ───────────────────────────────────────────────────────────────────────
# URL publique de l'app (sans slash final). En local : http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://app.monpassformation.com

# ── Auth / Session ─────────────────────────────────────────────────────────────
# Secret de chiffrement du cookie de session — minimum 32 caractères.
# Générer : openssl rand -base64 32
SESSION_SECRET=remplacez-par-au-moins-trente-deux-caracteres-aleatoires

# ── Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Requis pour /formation/admin : création de comptes + accès complet sans Stripe.
# Secret serveur uniquement, jamais exposé côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Prix en centimes (défaut : 29900 = 299,00 €). Modifier ici sans toucher au code.
FORMATION_PRICE_CENTS=29900

# ── OpenAI (Coach IA + TTS) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Upstash Redis (rate limiting persisté — https://console.upstash.com) ──────
# Créer une base Redis, puis copier l'URL et le token depuis l'onglet "REST API".
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Resend (emails automatiques — https://resend.com) ────────────────────────
RESEND_API_KEY=re_...

# ── Vercel Cron (relance inactifs) ────────────────────────────────────────────
# Générer : openssl rand -hex 32
CRON_SECRET=remplacez-par-secret-aleatoire

# ── D-ID (vidéos avatar — optionnel) ──────────────────────────────────────────
# Studio : https://studio.d-id.com/
# DID_API_USER=
# DID_API_SECRET=

# ── Fal.ai (génération images — optionnel) ────────────────────────────────────
# FAL_KEY=
