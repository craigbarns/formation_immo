.env*
!.env.local.example
!.env.production.example

# vercel
.vercel

# Supabase CLI local state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# sorties locales D-ID (URLs temporaires)
scripts/lesson-01-did-output.json

# venv local (script SadTalker)
scripts/.venv-sadtalker/
