# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement — PRODUCTION
# ─────────────────────────────────────────────────────────────────────────────
# Ce fichier est un TEMPLATE. Les vraies valeurs doivent être configurées
# dans Vercel : Project → Settings → Environment Variables (Production).
# Le fichier .env.production réel est gitignored et ne doit PAS être commité.
# ─────────────────────────────────────────────────────────────────────────────

# Domaines publics
NEXT_PUBLIC_SITE_URL=https://monpassformation.com
NEXT_PUBLIC_APP_URL=https://app.monpassformation.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Supabase — clés publiques (safe to commit côté Vercel, exposées au browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<votre clé anon publique Supabase>

# Supabase admin — requis pour /formation/admin :
# création directe de comptes apprenants + accès complet sans Stripe.
# ⚠️ SECRET — à définir UNIQUEMENT dans Vercel env vars, jamais côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=<votre service role key Supabase>

# Mistral AI — coach IA intégré
# ⚠️ SECRET — à définir UNIQUEMENT dans Vercel env vars, jamais ici.
MISTRAL_API_KEY=<votre clé API Mistral — https://console.mistral.ai>

# Deepgram — voix de Marie (TTS Aura-2 français)
# ⚠️ SECRET — à définir UNIQUEMENT dans Vercel env vars, jamais ici.
DEEPGRAM_API_KEY=<votre clé API Deepgram — https://console.deepgram.com>
